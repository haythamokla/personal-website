---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PageIntro from '../components/PageIntro.astro';
import { getCopy } from '../lib/copy';
import { site } from '../lib/site';

const copy = getCopy('en');
const breadcrumbs = [
	{ name: copy.common.home, url: '/' },
	{ name: copy.contact.title, url: '/contact/' },
];
---

<BaseLayout
	title={copy.contact.title}
	description={copy.contact.description}
	canonical="/contact/"
	breadcrumbs={breadcrumbs}
>
	<Breadcrumbs items={breadcrumbs} />
	<PageIntro eyebrow={copy.contact.eyebrow} title={copy.contact.heading} text={copy.contact.text} />

	<section class="container contact-layout">
		<div class="contact-form booking-card" aria-label="Booking appointment">
			<p class="eyebrow">Booking</p>
			<h2>Book a photography session.</h2>
			<p class="muted">Use the legacy portfolio booking page to send your appointment request.</p>
			<a class="button" href="https://legacy.haythamokla.com/contact" rel="noreferrer">{copy.common.bookAppointment}</a>
		</div>

		<aside class="contact-panel">
			<div>
				<p class="eyebrow">{copy.common.direct}</p>
				<a href={`mailto:${site.email}`}>{site.email}</a>
				<p>{site.location}</p>
			</div>
			<div>
				<p class="eyebrow">{copy.common.social}</p>
				<nav aria-label="Social media">
					{site.socials.map((social) => <a href={social.href} rel="noreferrer">{social.label}</a>)}
				</nav>
			</div>
		</aside>
	</section>
</BaseLayout>

<style>
	.contact-layout {
		display: grid;
		gap: 2rem;
		padding-bottom: clamp(4rem, 8vw, 7rem);
	}

	.contact-form,
	.contact-panel {
		border-top: 1px solid var(--line);
		padding-top: 1rem;
	}

	.contact-form {
		display: grid;
		gap: 1rem;
	}

	.booking-card {
		align-content: start;
	}

	.booking-card h2 {
		font-size: clamp(2rem, 5vw, 3.8rem);
	}

	.contact-form .button {
		width: fit-content;
	}

	.contact-panel {
		display: grid;
		align-content: start;
		gap: 2rem;
	}

	.contact-panel div,
	.contact-panel nav {
		display: grid;
		gap: 0.7rem;
	}

	.contact-panel a,
	.contact-panel p:not(.eyebrow) {
		color: var(--muted);
	}

	@media (min-width: 780px) {
		.contact-layout {
			grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
		}
	}
</style>
